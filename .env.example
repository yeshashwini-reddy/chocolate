# ==============================================================================
# MADHURI'S CHOCO HEAVEN - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
#
# Client-side Vite Variables:
# These variables are baked into the frontend bundle at build time by Vite.
# In Render, provide these in the Environment Variables dashboard of your Web Service.
#
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Server Runtime Variables:
# Render automatically injects PORT at runtime.
PORT=10000
NODE_ENV=production

# NOTE ON SECRETS:
# Server-side secrets (SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET) must NEVER
# be placed in this file, the Docker image, or frontend environment variables.
# They are securely managed exclusively inside Supabase Edge Function Secrets.
